/** C0 : morceaux de 500 m streamés en 3×3 autour du joueur. Pré-généré (glTF) prioritaire sur la graine. */
import { CHUNK, chunkOrigin, chunksAround, chunkHeights } from "../core/gen.js";

export function createTerrain(eng, phys, gen, cfg, data) {
  const { THREE, scene } = eng, seg = cfg.world.chunkSegments;
  const live = new Map(), queue = [];
  const groundTex = noiseTexture(THREE);
  groundTex.repeat.set(CHUNK / 8, CHUNK / 8);
  const mat = eng.material({ vertexColors: true, map: groundTex });
  const treeGeo = new THREE.ConeGeometry(3, 12, 5); treeGeo.translate(0, 6, 0);
  const treeMat = eng.material({ color: "#24402a" });
  const pre = (data.terrain && data.terrain.pregenerated) || {};
  const tmp = new THREE.Color(), tmp2 = new THREE.Color();

  function build(cx, cz) {
    const key = cx + "_" + cz, [ox, oz] = chunkOrigin(cx, cz);
    if (pre[key]) return loadPre(key, ox, oz);
    const h = chunkHeights(gen, cx, cz, seg);
    const geo = new THREE.PlaneGeometry(CHUNK, CHUNK, seg, seg); geo.rotateX(-Math.PI / 2); geo.translate(CHUNK / 2, 0, CHUNK / 2);
    const p = geo.attributes.position, col = new Float32Array(p.count * 3);
    for (let i = 0; i < p.count; i++) {
      p.setY(i, h[i]);
      const b = gen.biomeAt(ox + p.getX(i), oz + p.getZ(i));
      tmp.set(b.color[0]); tmp2.set(b.color[1]);
      tmp.lerp(tmp2, Math.min(1, h[i] / (b.height * 0.9 || 1)));
      if (gen.isCity(cx, cz)) tmp.set("#6a6478");
      col.set([tmp.r, tmp.g, tmp.b], i * 3);
    }
    geo.setAttribute("color", new THREE.BufferAttribute(col, 3));
    geo.computeVertexNormals();
    const mesh = new THREE.Mesh(geo, mat); mesh.position.set(ox, 0, oz); mesh.receiveShadow = true; mesh.userData.pick = "ground";
    const grp = new THREE.Group(); grp.add(mesh);
    // arbres (forêt) : suggérés, pas simulés
    const rnd = mulberry(cx * 73856093 ^ cz * 19349663);
    const trees = [];
    for (let i = 0; i < 160; i++) { const x = rnd() * CHUNK, z = rnd() * CHUNK, b = gen.biomeAt(ox + x, oz + z); if (b.trees && rnd() < b.trees / 60) trees.push([x, gen.height(ox + x, oz + z), z]); }
    if (trees.length && !gen.isCity(cx, cz)) {
      const im = new THREE.InstancedMesh(treeGeo, treeMat, trees.length), m4 = new THREE.Matrix4();
      trees.forEach((t, i) => im.setMatrixAt(i, m4.makeTranslation(t[0], t[1], t[2])));
      im.position.set(ox, 0, oz); im.castShadow = true; grp.add(im);
    }
    scene.add(grp);
    const col3 = phys.trimesh(geo, [ox, 0, oz]);
    return { grp, colliders: [col3], mesh };
  }
  function loadPre(key, ox, oz) {
    const grp = new THREE.Group(); scene.add(grp);
    const rec = { grp, colliders: [], mesh: null };
    eng.loadGLB(pre[key]).then((g) => {
      const box = new THREE.Box3().setFromObject(g.scene), s = CHUNK / Math.max(1e-3, box.max.x - box.min.x);
      g.scene.scale.setScalar(s); g.scene.position.set(ox - box.min.x * s, -box.min.y * s, oz - box.min.z * s); grp.add(g.scene);
      g.scene.updateMatrixWorld(true);
      g.scene.traverse((o) => { if (o.isMesh) { o.userData.pick = "ground"; o.receiveShadow = true; rec.colliders.push(phys.trimesh(o.geometry, null, o.matrixWorld)); rec.mesh = o; } });
    });
    return rec;
  }
  function update(x, z) {
    const need = chunksAround(x, z, cfg.world.streamRadius), keys = new Set(need.map((c) => c[0] + "_" + c[1]));
    for (const [k, r] of live) if (!keys.has(k)) { scene.remove(r.grp); r.grp.traverse((o) => o.geometry && o.geometry !== treeGeo && o.geometry.dispose()); r.colliders.forEach((c) => phys.remove(c)); live.delete(k); }
    need.forEach((c) => { const k = c[0] + "_" + c[1]; if (!live.has(k) && !queue.includes(k)) queue.push(k); });
    if (queue.length) { const k = queue.shift(); if (keys.has(k) && !live.has(k)) { const [cx, cz] = k.split("_").map(Number); live.set(k, build(cx, cz)); } }
  }
  return { update, live, pickables: () => [...live.values()].map((r) => r.mesh).filter(Boolean), pending: () => queue.length };
}

/** Texture de sol procédurale (bruit + graviers), répétée ; teintée par les couleurs de biome. */
function noiseTexture(THREE) {
  const n = 128, cv = document.createElement("canvas"); cv.width = cv.height = n; const g = cv.getContext("2d"), img = g.createImageData(n, n), r = mulberry(1234);
  for (let i = 0; i < n * n; i++) { const v = 170 + r() * 70 + (r() < 0.04 ? -70 : 0); img.data.set([v, v, v, 255], i * 4); }
  g.putImageData(img, 0, 0);
  const t = new THREE.CanvasTexture(cv); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.magFilter = THREE.NearestFilter; t.colorSpace = THREE.SRGBColorSpace; return t;
}
function mulberry(a) { return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
