*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden;background:#07060d;color:#eee;font:12px system-ui,sans-serif;touch-action:none}
#view{position:fixed;inset:0;width:100%;height:100%}
#hud{position:fixed;top:0;left:0;right:0;padding:8px;background:linear-gradient(#07060dcc,#07060d00);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11px}
#toast{position:fixed;top:36px;left:50%;transform:translateX(-50%);max-width:90vw;background:#1c1622ee;border-left:3px solid #ff2e88;padding:6px 10px;opacity:0;transition:opacity .3s}
#loading{position:fixed;inset:0;display:grid;place-items:center;background:#07060d;font-size:14px}
#bar{position:fixed;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:6px 6px calc(6px + env(safe-area-inset-bottom));background:#07060dd9}
#bar button{min-width:0;font:inherit;font-size:12px;color:#fff;background:#221c2c;border:1px solid #ff2e8899;border-radius:8px;padding:10px 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
